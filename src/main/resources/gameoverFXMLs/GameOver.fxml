<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gameover.GameOverController">
   <children>
      <Text fx:id="txtGameOver" strokeType="OUTSIDE" strokeWidth="0.0" text="GAME OVER" StackPane.alignment="TOP_CENTER">
         <font>
            <Font size="50.0" />
         </font>
         <StackPane.margin>
            <Insets top="75.0" />
         </StackPane.margin>
      </Text>
      <Text fx:id="txtLvl" strokeType="OUTSIDE" strokeWidth="0.0" text="ACHIEVED LEVEL" StackPane.alignment="TOP_CENTER">
         <font>
            <Font size="25.0" />
         </font>
         <StackPane.margin>
            <Insets top="150.0" />
         </StackPane.margin>
      </Text>
      <Button fx:id="btnRestartGame" mnemonicParsing="false" onAction="#restartGame" text="RESTART GAME" StackPane.alignment="TOP_CENTER">
         <StackPane.margin>
            <Insets right="200.0" top="300.0" />
         </StackPane.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="btnReturnToMenu" mnemonicParsing="false" onAction="#returnToMenu" text="GO TO MENU" StackPane.alignment="TOP_CENTER">
         <StackPane.margin>
            <Insets right="-200.0" top="300.0" />
         </StackPane.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</StackPane>
